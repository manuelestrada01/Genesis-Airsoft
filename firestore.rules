rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() &&
          request.auth.uid == "q5jsUMMeG6VaZUsxs9WtAqzYMIH3";
      }

      function isOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      // ============================================
      // CARRITOS
      // ============================================
      match /carts/{userId} {
        allow read, write:
          if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // ============================================
      // ÓRDENES
      // ============================================
      match /orders/{orderId} {
        allow read: if isOwner() || isAdmin();
        allow create: if false;
        allow update: if isOwner()
          && resource.data.paymentType == "bank_transfer"
          && resource.data.status == "pending_transfer"
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["transferProof", "status", "updatedAt"])
          && request.resource.data.status == "transfer_proof_submitted"
          && request.resource.data.transferProof is map
          && request.resource.data.transferProof.url is string
          && request.resource.data.transferProof.path is string
          && request.resource.data.transferProof.name is string;
        allow update, delete: if isAdmin();
      }

      // ============================================
      // PRODUCTOS
      // ============================================
      match /products/{id} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // ============================================
      // CATEGORÍAS
      // ============================================
      match /categories/{id} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // ============================================
      // VENTAS (app móvil)
      // ============================================
      match /sales/{id} {
        allow read, write: if isAdmin();
      }

      // ============================================
      // GASTOS (app móvil)
      // ============================================
      match /expenses/{id} {
        allow read, write: if isAdmin();
      }

      // ============================================
      // CONFIGURACIÓN DE ALQUILERES
      // ============================================
      match /rentalConfig/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // ============================================
      // PARTIDAS
      // ============================================
      match /partidas/{id} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // ============================================
      // RESERVAS DE ALQUILER
      // ============================================
      match /rentalReservations/{id} {
        allow read: if isOwner() || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isOwner()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['comprobanteUrl', 'comprobantePath', 'comprobanteAt', 'updatedAt']));
        allow delete: if false;
      }

      // ============================================
      // SERVICIO TÉCNICO
      // ============================================
      match /servicioConfig/{id} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /servicioSlots/{id} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /servicioTurnos/{id} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ============================================
      // PRESUPUESTOS MANUALES
      // ============================================
      match /presupuestosManuales/{id} {
        allow read, write: if isAdmin();
      }
    }
  }
